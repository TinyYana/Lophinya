+            // context, so the allow-list check happens here at the call site instead of inside it.
+            if (!fun.bm.lophinya.compat.LophinyaFoliaSupportedGate.isAllowed(this.path)) {
+                server.getUnsafe().checkSupported(this.description);
+            }
+            // Lophinya end - folia-supported gate defaults open
 
             final PluginClassLoader loader;
             try {

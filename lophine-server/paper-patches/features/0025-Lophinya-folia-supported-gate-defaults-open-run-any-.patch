index 8f0b7b2985d3aadaacd5313d52d48ac916d871c9..51117c5813ede0f48c69e76238b9cc0cbab90f15 100644
--- a/src/main/java/io/papermc/paper/plugin/provider/type/spigot/SpigotPluginProviderFactory.java

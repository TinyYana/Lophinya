From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Lophinya <lophinya@localhost>
Date: Mon, 27 Jul 2026 00:25:30 +0800
Subject: [PATCH] Lophinya: Runtime access guard + restore Bukkit async
 scheduler

Folia replaces CraftScheduler.handle with an unconditional, message-less throw.
Two problems with that, addressed separately and both switchable:

1. Diagnostics. The bare UnsupportedOperationException names the plugin class and
   nothing else. LophinyaSchedulerDiagnostics logs plugin name+version, jar file
   and SHA-256, the Bukkit scheduler method actually called, delay/period, the
   sync/async flag, the plugin callsite, and the thread/region context - once per
   distinct callsite. Behaviour is unchanged; the call still throws.
   Kill switch: -Dlophinya.compat.diagnostics=false

2. Async reach. Folia's throw also killed the async path, which never needed a
   main thread - Paper already runs those on CraftAsyncScheduler's own pool.
   Restoring that delegation is a return to Paper semantics, not a compatibility
   shim, and async tasks that illegally touch world state are still caught by
   Folia's thread-ownership checks. Folia commented out the per-tick
   mainThreadHeartbeat, so the async scheduler's clock is driven from
   FoliaGlobalRegionScheduler.tick() - counter only, no plugin code runs there.
   Sync tasks are still rejected, deliberately.
   Kill switch: -Dlophinya.compat.restoreAsyncScheduler=false

diff --git a/src/main/java/fun/bm/lophinya/compat/LophinyaCompatConfig.java b/src/main/java/fun/bm/lophinya/compat/LophinyaCompatConfig.java
new file mode 100644
index 0000000000000000000000000000000000000000..c37a7a2571ea24a0e7fe5ddffe7fa9fbf0c71dc4
--- /dev/null
+++ b/src/main/java/fun/bm/lophinya/compat/LophinyaCompatConfig.java
@@ -0,0 +1,29 @@
+package fun.bm.lophinya.compat;
+
+/**
+ * Lophinya compatibility switches.
+ *
+ * <p>System properties rather than a config file on purpose: every one of these is a rollback
+ * lever, and a lever you can pull from the start script without editing YAML is a better lever.
+ * Read once at class-init so the JIT can fold them away.
+ *
+ * <pre>
+ *   -Dlophinya.compat.restoreAsyncScheduler=false   # revert to Folia stock: reject async Bukkit tasks
+ *   -Dlophinya.compat.diagnostics=false             # silence the rejection diagnostics
+ * </pre>
+ */
+public final class LophinyaCompatConfig {
+
+    /**
+     * Restore Paper's {@code CraftAsyncScheduler} delegation for async Bukkit scheduler tasks.
+     *
+     * <p>Folia rejects these, but nothing about an async task requires a main thread — Paper has
+     * always run them on a separate pool. Tasks that illegally touch world state are still caught
+     * by Folia's thread-ownership checks, so this restores reach without weakening safety.
+     */
+    public static final boolean RESTORE_ASYNC_SCHEDULER =
+        !"false".equalsIgnoreCase(System.getProperty("lophinya.compat.restoreAsyncScheduler", "true"));
+
+    private LophinyaCompatConfig() {
+    }
+}
diff --git a/src/main/java/fun/bm/lophinya/compat/LophinyaSchedulerDiagnostics.java b/src/main/java/fun/bm/lophinya/compat/LophinyaSchedulerDiagnostics.java
new file mode 100644
index 0000000000000000000000000000000000000000..628251d272dafe225c740a73b627a7d990bc91cd
--- /dev/null
+++ b/src/main/java/fun/bm/lophinya/compat/LophinyaSchedulerDiagnostics.java
@@ -0,0 +1,182 @@
+package fun.bm.lophinya.compat;
+
+import com.mojang.logging.LogUtils;
+import org.bukkit.plugin.Plugin;
+import org.slf4j.Logger;
+
+import java.net.URI;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.security.MessageDigest;
+import java.util.HexFormat;
+import java.util.Map;
+import java.util.Set;
+import java.util.concurrent.ConcurrentHashMap;
+
+/**
+ * Lophinya: purely diagnostic reporting for Bukkit scheduler calls that Folia rejects.
+ *
+ * <p>Folia's {@code CraftScheduler.handle} throws a bare {@link UnsupportedOperationException}
+ * with no message. The stack trace names the plugin class, but not the plugin version, the jar
+ * it came from, the scheduler flavour, the delay/period, or the thread context. That makes
+ * "which plugin, doing what, from where" a manual archaeology job every single time.
+ *
+ * <p>This class changes <b>nothing</b> about scheduling behaviour. It only turns one opaque
+ * exception into one attributable log record. The caller still throws exactly as before.
+ *
+ * <p>Kill switch: {@code -Dlophinya.compat.diagnostics=false}.
+ */
+public final class LophinyaSchedulerDiagnostics {
+
+    private static final Logger LOGGER = LogUtils.getLogger();
+
+    public static final boolean ENABLED =
+        !"false".equalsIgnoreCase(System.getProperty("lophinya.compat.diagnostics", "true"));
+
+    /** Report each distinct (plugin, callsite, method) once. A rejected ticker would otherwise spam. */
+    private static final Set<String> REPORTED = ConcurrentHashMap.newKeySet();
+
+    /** SHA-256 of a plugin jar is stable for the run; hashing a 10 MB jar per call would not be free. */
+    private static final Map<String, String> JAR_SHA = new ConcurrentHashMap<>();
+
+    /** Frames belonging to the scheduler plumbing itself — never the answer to "who called this". */
+    private static final String[] PLUMBING = {
+        "org.bukkit.craftbukkit.scheduler.",
+        "org.bukkit.scheduler.",
+        "io.papermc.paper.threadedregions.",
+        "fun.bm.lophinya.compat.",
+    };
+
+    private LophinyaSchedulerDiagnostics() {
+    }
+
+    /**
+     * Log one attributable record for a scheduler call Folia is about to reject.
+     *
+     * @param plugin the calling plugin
+     * @param delay  delay in ticks, or -1 when not applicable
+     * @param period period in ticks, {@code -1} meaning no repeat
+     * @param async  whether the task was submitted as an async task
+     * @return a short human-readable reason, suitable for the thrown exception's message
+     */
+    public static String reportRejected(final Plugin plugin,
+                                        final long delay, final long period, final boolean async) {
+        // ponytail: diagnostics must never be the reason a server dies. Everything below is best-effort.
+        try {
+            final String[] frames = walk();
+            final String method = frames[0];
+            final String callsite = frames[1];
+            final String name = plugin == null ? "<null>" : plugin.getName();
+            final String key = name + '|' + callsite + '|' + method;
+
+            final String reason = (async ? "async" : "sync")
+                + " Bukkit scheduler task from " + name
+                + " (" + method + ", delay=" + delay + ", period=" + period + ") "
+                + "is not supported under regionised threading";
+
+            if (!ENABLED || !REPORTED.add(key)) {
+                return reason;
+            }
+
+            LOGGER.warn("""
+                [Lophinya] Rejected Bukkit scheduler call
+                  plugin    : {} v{}
+                  jar       : {}
+                  jar sha256: {}
+                  scheduler : {} (delay={} ticks, period={} ticks, async={})
+                  callsite  : {}
+                  context   : {}
+                  why       : Folia has no single main thread. Use RegionScheduler (block/location),
+                              EntityScheduler (entity), GlobalRegionScheduler (server-global) or
+                              AsyncScheduler. This message is diagnostic only; the call still fails.""",
+                name, version(plugin), jarName(plugin), jarSha(plugin),
+                method, delay, period, async, callsite, context());
+
+            return reason;
+        } catch (final Throwable t) {
+            LOGGER.warn("[Lophinya] scheduler diagnostics failed (harmless)", t);
+            return "unsupported Bukkit scheduler call";
+        }
+    }
+
+    /**
+     * One stack walk, two answers:
+     * <ul>
+     *   <li>[0] the Bukkit scheduler API method the plugin actually called — the <i>outermost</i>
+     *       plumbing frame, e.g. {@code BukkitRunnable.runTaskTimer}</li>
+     *   <li>[1] the plugin callsite — the <i>innermost</i> frame that is not plumbing</li>
+     * </ul>
+     */
+    private static String[] walk() {
+        final String[] out = {"<unknown>", "<unknown>"};
+        StackWalker.getInstance().forEach(f -> {
+            final String cn = f.getClassName();
+            boolean plumbing = false;
+            for (final String p : PLUMBING) {
+                if (cn.startsWith(p)) {
+                    plumbing = true;
+                    break;
+                }
+            }
+            if (plumbing) {
+                // keep overwriting: the last plumbing frame seen is the API the plugin called
+                if ("<unknown>".equals(out[1])) {
+                    out[0] = cn.substring(cn.lastIndexOf('.') + 1) + '.' + f.getMethodName();
+                }
+            } else if ("<unknown>".equals(out[1])) {
+                out[1] = cn + '.' + f.getMethodName() + '(' + f.getFileName() + ':' + f.getLineNumber() + ')';
+            }
+        });
+        return out;
+    }
+
+    /** Which thread and which region we were on when the call came in. */
+    private static String context() {
+        final StringBuilder sb = new StringBuilder(96);
+        sb.append("thread=").append(Thread.currentThread().getName());
+        try {
+            final Object region = io.papermc.paper.threadedregions.TickRegionScheduler.getCurrentRegion();
+            sb.append(region == null ? ", region=none (no owning region on this thread)" : ", region=" + region);
+        } catch (final Throwable ignored) {
+            sb.append(", region=<unavailable>");
+        }
+        return sb.toString();
+    }
+
+    private static String version(final Plugin plugin) {
+        try {
+            return plugin.getPluginMeta().getVersion();
+        } catch (final Throwable ignored) {
+            return "<unknown>";
+        }
+    }
+
+    private static Path jarPath(final Plugin plugin) {
+        try {
+            final URI uri = plugin.getClass().getProtectionDomain().getCodeSource().getLocation().toURI();
+            return Path.of(uri);
+        } catch (final Throwable ignored) {
+            return null;
+        }
+    }
+
+    private static String jarName(final Plugin plugin) {
+        final Path p = jarPath(plugin);
+        return p == null ? "<unknown>" : p.getFileName().toString();
+    }
+
+    private static String jarSha(final Plugin plugin) {
+        final Path p = jarPath(plugin);
+        if (p == null) {
+            return "<unknown>";
+        }
+        return JAR_SHA.computeIfAbsent(p.toString(), path -> {
+            try {
+                final MessageDigest md = MessageDigest.getInstance("SHA-256");
+                return HexFormat.of().formatHex(md.digest(Files.readAllBytes(Path.of(path))));
+            } catch (final Throwable ignored) {
+                return "<unreadable>";
+            }
+        });
+    }
+}
diff --git a/src/main/java/io/papermc/paper/threadedregions/scheduler/FoliaGlobalRegionScheduler.java b/src/main/java/io/papermc/paper/threadedregions/scheduler/FoliaGlobalRegionScheduler.java
index f20f2735fbb4d1e38d576eafe18a0054a45aa59e..68c40176df03abe1d1d485e4b5596647b8dda0be 100644
--- a/src/main/java/io/papermc/paper/threadedregions/scheduler/FoliaGlobalRegionScheduler.java
+++ b/src/main/java/io/papermc/paper/threadedregions/scheduler/FoliaGlobalRegionScheduler.java
@@ -20,6 +20,19 @@ public class FoliaGlobalRegionScheduler implements GlobalRegionScheduler {
     private final Object stateLockForTaskId = new Object(); // Lophine - add task id
 
     public void tick() {
+        // Lophinya start - drive the restored Bukkit async scheduler off the global tick
+        // Folia commented out MinecraftServer's per-tick mainThreadHeartbeat(), which is what used to
+        // advance CraftAsyncScheduler's clock. Without this, restored async tasks would be accepted
+        // and then never fire. Only the async scheduler's counter is advanced here; no plugin code
+        // runs on the global tick thread as a result.
+        if (fun.bm.lophinya.compat.LophinyaCompatConfig.RESTORE_ASYNC_SCHEDULER) {
+            final org.bukkit.scheduler.BukkitScheduler bukkitScheduler = org.bukkit.Bukkit.getScheduler();
+            if (bukkitScheduler instanceof org.bukkit.craftbukkit.scheduler.CraftScheduler craftScheduler) {
+                craftScheduler.lophinya$asyncHeartbeat();
+            }
+        }
+        // Lophinya end - drive the restored Bukkit async scheduler off the global tick
+
         final List<GlobalScheduledTask> run;
         synchronized (this.stateLock) {
             ++this.tickCount;
diff --git a/src/main/java/org/bukkit/craftbukkit/scheduler/CraftScheduler.java b/src/main/java/org/bukkit/craftbukkit/scheduler/CraftScheduler.java
index c4dcddc4db02ed3641d05fae31ead7c13205f841..3392460128efd78cecfe67cfbec367b91edd0b27 100644
--- a/src/main/java/org/bukkit/craftbukkit/scheduler/CraftScheduler.java
+++ b/src/main/java/org/bukkit/craftbukkit/scheduler/CraftScheduler.java
@@ -514,7 +514,25 @@ public class CraftScheduler implements BukkitScheduler {
     }
 
     protected CraftTask handle(final CraftTask task, final long delay) { // Paper
-        if (true) throw new UnsupportedOperationException(); // Folia - region threading
+        // Lophinya start - restore Bukkit async scheduler semantics + diagnostic guard
+        // Folia replaced this whole method with an unconditional, message-less throw. That is correct
+        // for *sync* tasks (there is no main thread to run them on), but it also killed the *async*
+        // path, which never needed a main thread: Paper already runs those on CraftAsyncScheduler's
+        // own pool. Restoring it is a return to Paper semantics, not a compatibility shim - and any
+        // async task that does touch world state still hits Folia's thread-ownership checks, loudly.
+        if (!this.isAsyncScheduler && !task.isSync() && fun.bm.lophinya.compat.LophinyaCompatConfig.RESTORE_ASYNC_SCHEDULER) {
+            this.asyncScheduler.handle(task, delay);
+            return task;
+        }
+        if (this.isAsyncScheduler && fun.bm.lophinya.compat.LophinyaCompatConfig.RESTORE_ASYNC_SCHEDULER) {
+            task.setNextRun(this.currentTick + delay);
+            this.addTask(task);
+            return task;
+        }
+        throw new UnsupportedOperationException(fun.bm.lophinya.compat.LophinyaSchedulerDiagnostics.reportRejected(
+            task.getOwner(), delay, task.getPeriod(), !task.isSync()));
+        // Lophinya end - restore Bukkit async scheduler semantics + diagnostic guard
+        /* // Folia - region threading
         // Paper start
         if (!this.isAsyncScheduler && !task.isSync()) {
             this.asyncScheduler.handle(task, delay);
@@ -524,6 +542,20 @@ public class CraftScheduler implements BukkitScheduler {
         task.setNextRun(this.currentTick + delay);
         this.addTask(task);
         return task;
+        */ // Folia - region threading
+    }
+
+    /**
+     * Lophinya: advance only the async scheduler's clock.
+     * <p>{@link CraftAsyncScheduler#mainThreadHeartbeat()} increments a counter and hands the work
+     * to its own single management thread - no plugin code runs on the caller. That makes it safe
+     * to drive from Folia's global tick, which is what this exists for. Deliberately <b>not</b>
+     * {@link #mainThreadHeartbeat()}, which would also drain the sync queue.
+     */
+    public void lophinya$asyncHeartbeat() {
+        if (!this.isAsyncScheduler && this.asyncScheduler != null) {
+            this.asyncScheduler.mainThreadHeartbeat();
+        }
     }
 
     private static void validate(final Plugin plugin, final Object task) {

From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: TinyYana <yanasakuranight@gmail.com>
Date: Tue, 28 Jul 2026 14:19:12 +0800
Subject: [PATCH] Lophinya: Per-jar folia-supported allow-list

Folia's plugin-load gate rejects any jar not declaring folia-supported:
true, before onEnable() ever runs. That declaration is the plugin's own
one-time self-report - not a runtime safety mechanism. The real safety
mechanism (region ownership / TickThread.ensureTickThread) runs on every
world-state access regardless of what plugin.yml says, and is completely
untouched by this patch.

LophinyaFoliaSupportedAllowlist is a SHA-256-keyed allow-list, deliberately
the opposite shape of Luminol's disable_check_for_folia_supported: that
switch is global and blanket; this only lets through jars individually
research-cleared via CORE-SHIM-RESEARCH (project-docs evidence/), one exact
(plugin, version) hash at a time. A version bump drops out of the list
automatically.

Two call sites patched (legacy plugin.yml plugins hit both - a discovery-
time gate in SpigotPluginProviderFactory and a second, independent gate at
enable time in SpigotPluginProvider.checkSupported; paper-plugin.yml format
gets the same treatment in PaperPluginProviderFactory for consistency, none
of the four researched plugins currently use that format).

First entry: GriefPrevention 16.18.7, cleared by T-09/T-09b (8 of 9
scheduler callsites individually re-dispatchable without bypassing any
ownership check; evidence/20260728-griefprevention-core-shim-implementation-plan.md).

Kill switch: -Dlophinya.compat.foliaSupportedAllowlist=false

diff --git a/src/main/java/fun/bm/lophinya/compat/LophinyaFoliaSupportedAllowlist.java b/src/main/java/fun/bm/lophinya/compat/LophinyaFoliaSupportedAllowlist.java
new file mode 100644
index 0000000000000000000000000000000000000000..3a19539cc9929e4afa34d9395d83c9a8d6c8b73e
--- /dev/null
+++ b/src/main/java/fun/bm/lophinya/compat/LophinyaFoliaSupportedAllowlist.java
@@ -0,0 +1,130 @@
+package fun.bm.lophinya.compat;
+
+import com.mojang.logging.LogUtils;
+import org.slf4j.Logger;
+
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.security.MessageDigest;
+import java.util.HexFormat;
+import java.util.Map;
+import java.util.Set;
+import java.util.concurrent.ConcurrentHashMap;
+
+/**
+ * Lophinya: SHA-256-keyed allow-list for third-party plugins with no official Folia build.
+ *
+ * <p>Folia's plugin loader rejects any jar that doesn't declare {@code folia-supported: true} in
+ * its own manifest, before {@code onEnable()} ever runs. That declaration is the plugin's own
+ * one-time self-report, read once at load time - it is <b>not</b> a runtime safety mechanism.
+ * The real safety mechanism is region ownership checking ({@code TickThread.ensureTickThread}),
+ * which runs on every Bukkit world-state access regardless of what a plugin's {@code plugin.yml}
+ * says, and is completely untouched by this class.
+ *
+ * <p>This is deliberately the opposite shape of Luminol's
+ * {@code disable_check_for_folia_supported} (see {@link LophinyaCompatConfig}'s sibling switch in
+ * upstream): that flag is global, applies to every plugin with zero per-plugin analysis, and is
+ * explicitly kept out of any delivery configuration. This allow-list only lets through jars that
+ * are individually SHA-256-locked and have each had their own {@code CORE-SHIM-RESEARCH} writeup
+ * (see project-docs {@code evidence/}) - adding an entry here is a specific, reviewable decision
+ * about one exact artifact, not a blanket bypass. A version bump changes the hash and drops back
+ * out of the allow-list automatically; nothing here is inherited across versions.
+ *
+ * <p>Kill switch: {@code -Dlophinya.compat.foliaSupportedAllowlist=false}. When disabled, every
+ * jar goes back through the stock Folia gate with no exceptions, including jars in {@link #HASHES}.
+ */
+public final class LophinyaFoliaSupportedAllowlist {
+
+    private static final Logger LOGGER = LogUtils.getLogger();
+
+    public static final boolean ENABLED =
+        !"false".equalsIgnoreCase(System.getProperty("lophinya.compat.foliaSupportedAllowlist", "true"));
+
+    /**
+     * SHA-256 (uppercase hex, no separators) of jars individually researched and cleared to skip
+     * the {@code folia-supported} declaration gate, mapped to a short label for the log line.
+     * One entry per (plugin, exact version) pair - a new release requires a new hash and its own
+     * research writeup; it is never inherited from a prior version's entry.
+     */
+    private static final Map<String, String> HASHES = Map.of(
+        // GriefPrevention 16.18.7 (s01-installed version). No official Folia path (canonical
+        // upstream maintainer: "every write is a roll of the dice for data corruption"). Core-shim
+        // research (project-docs evidence/20260728-t09-griefprevention-callsite-analysis.md and
+        // .../20260728-t09b-griefprevention-per-callsite-dispatch-feasibility.md) found 8 of 9
+        // scheduler callsites individually re-dispatchable without bypassing any ownership check;
+        // only EntityCleanupTask remains a known, accepted degradation (see
+        // evidence/20260728-griefprevention-core-shim-implementation-plan.md). Skipping *this*
+        // gate does not weaken ownership checking in any way - it only lets onEnable() and event
+        // registration run, so the scheduler dispatch fixes in this patch series have something to
+        // attach to.
+        "45E9907C61222E559ED2E099FFEE0EDE706A21243A31D7DB549BAF678708FDF0", "GriefPrevention 16.18.7",
+        // DecentHolograms 2.10.1 (s01-installed version). No official Folia path (upstream issue
+        // #123 confirms it). Core-shim research (evidence/20260728-t10-decenthollograms-
+        // callsite-analysis.md) found no sync scheduler call inside onEnable() itself - unlike
+        // GriefPrevention, this gate alone should be sufficient for onEnable() to complete. Its
+        // sync scheduler calls (Hologram.java:683, ActionType.java:69/83/116) are all triggered
+        // later, during actual gameplay (showing a legacy hologram page, running a command/
+        // console/teleport action), each with a single known Player at the point of scheduling -
+        // see evidence/20260728-decenthollograms-core-shim-implementation-plan.md for the
+        // per-callsite dispatch design (not yet implemented as of this entry).
+        "E247B7362C277DAD0596CB48B5D1570B1002FBA014A5AFD8458D978963A253B4", "DecentHolograms 2.10.1",
+        // Shopkeepers 2.27.0 (s01-installed version). No official Folia path (maintainer rejected
+        // upstream PR #1017). Core-shim research (evidence/20260728-t12-shopkeepers-callsite-
+        // analysis.md) found, unlike DecentHolograms, that onEnable() DOES call two unconditional
+        // sync scheduler registrations (ShopkeeperSpawner.onEnable(), ShopkeeperTicker.onEnable())
+        // with no try/catch - so passing the gate alone is expected to still fail onEnable() at
+        // whichever of those two fires first, same shape of problem GriefPrevention had before its
+        // scheduler dispatch rules existed. Added here specifically to empirically confirm that
+        // prediction (gate-only test, no dispatch rules yet for this plugin), not because the gate
+        // alone is expected to make it boot.
+        "4481DF8E0B5642A2835150103E951F0BB360B8158E33C2151781B3BD4A7260A4", "Shopkeepers 2.27.0"
+    );
+
+    /** SHA-256 of a jar is stable for the run; hashing it on every plugin-load check is wasteful. */
+    private static final Map<Path, String> SHA_CACHE = new ConcurrentHashMap<>();
+
+    /** Log the allow decision once per jar, not once per gate (there are two gates per plugin). */
+    private static final Set<String> LOGGED = ConcurrentHashMap.newKeySet();
+
+    private LophinyaFoliaSupportedAllowlist() {
+    }
+
+    /**
+     * @param jarPath path to the plugin jar being loaded
+     * @return true if this exact jar is individually cleared to skip the folia-supported gate
+     */
+    public static boolean isAllowed(final Path jarPath) {
+        if (!ENABLED || jarPath == null) {
+            return false;
+        }
+        try {
+            final String sha256 = SHA_CACHE.computeIfAbsent(jarPath, LophinyaFoliaSupportedAllowlist::hash);
+            final String label = HASHES.get(sha256);
+            if (label == null) {
+                return false;
+            }
+            if (LOGGED.add(sha256)) {
+                LOGGER.warn("[Lophinya] Allowing {} ({}) to skip the folia-supported load gate - "
+                    + "this SHA-256 was individually cleared by core-shim research, not a global "
+                    + "bypass. Region ownership checks are unaffected and still apply to every "
+                    + "world-state call this plugin makes.", jarPath.getFileName(), label);
+            }
+            return true;
+        } catch (final Throwable t) {
+            // ponytail: the allow-list must never be the reason a server dies, and must fail
+            // closed - any error here means "do not skip the gate", never "skip it anyway".
+            LOGGER.warn("[Lophinya] folia-supported allow-list check failed for {} (treating as not allowed)",
+                jarPath, t);
+            return false;
+        }
+    }
+
+    private static String hash(final Path jarPath) {
+        try {
+            final MessageDigest md = MessageDigest.getInstance("SHA-256");
+            return HexFormat.of().withUpperCase().formatHex(md.digest(Files.readAllBytes(jarPath)));
+        } catch (final Throwable t) {
+            return "<unreadable>";
+        }
+    }
+}

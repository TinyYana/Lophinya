+            if (!fun.bm.lophinya.compat.LophinyaFoliaSupportedAllowlist.isAllowed(this.path)) {
+                server.getUnsafe().checkSupported(this.description);
+            }
+            // Lophinya end - per-jar folia-supported allow-list
 
             final PluginClassLoader loader;
             try {
